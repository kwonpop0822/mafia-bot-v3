# 이 파일을 프로젝트 루트에 .env 이름으로 복사한 뒤 실제 값으로 바꾸세요.
# 예: cp .env.example .env

# Telegram BotFather에서 발급한 봇 토큰
TELEGRAM_TOKEN=123456789:REPLACE_WITH_YOUR_BOT_TOKEN

# /sudo 개발자 명령어 비밀번호. 운영 시 반드시 강한 값으로 변경하세요.
MAFIA_DEV_PASSWORD=REPLACE_WITH_A_STRONG_SECRET

# SQLite 데이터 폴더. 상대 경로는 이 프로젝트 폴더를 기준으로 처리됩니다.
MAFIA_DATA_DIR=./data

# DEBUG, INFO, WARNING, ERROR 중 하나
LOG_LEVEL=INFO
